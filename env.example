# Copy to `.env` and edit. Every value below is a placeholder — none is a real path,
# credential, or host on the machine where the experiments originally ran.

# ---- vLLM executable ----
# Defaults to `vllm` resolved from PATH when unset.
VLLM_BIN=vllm

# ---- Model ----
# Either a local snapshot directory or a Hugging Face repo id.
MODEL_PATH=models/Qwen3-VL-8B-Instruct
# MODEL_PATH=Qwen/Qwen3-VL-8B-Instruct

# ---- Base directory used when composing cache / server-side paths ----
VLLM_HOME=./

# ---- OpenAI-compatible endpoint of the vLLM server ----
VLLM_HOST=127.0.0.1
VLLM_PORT=8000

# ---- Where analysis scripts read frozen artifacts from ----
RESULTS_DIR=results

# ---- NOTES ----
# * The client sets `api_key="EMPTY"`. That is vLLM's placeholder for a server started
#   WITHOUT `--api-key`. It is not a credential and must not be replaced with a secret.
# * Do not commit the resulting `.env` — it is git-ignored.
